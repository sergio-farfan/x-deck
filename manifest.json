{
  "manifest_version": 3,
  "name": "XDeck",
  "short_name": "XDeck",
  "version": "0.1.4",
  "description": "Multi-column deck for X: live columns, layouts, filters, keyword alerts, collections and a clean reading mode.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open XDeck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "notifications",
    "contextMenus",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/i/xdeck*"],
      "js": ["content/deck-loader.js"],
      "css": ["deck.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*"],
      "exclude_matches": ["https://x.com/i/xdeck*"],
      "js": ["content/core.js", "content/frame.js"],
      "css": ["content/frame.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js", "icons/icon32.png"],
      "matches": ["https://x.com/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Open XDeck"
    }
  }
}
